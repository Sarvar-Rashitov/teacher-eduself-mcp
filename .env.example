# ==========================================
# EduSelf Teacher — Environment Variables
# ==========================================

# Django Settings
DJANGO_SETTINGS_MODULE=core.settings.local
SECRET_KEY=django-insecure-dev-key-change-in-production-eduself-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL 16)
POSTGRES_DB=eduself_db
POSTGRES_USER=eduself_user
POSTGRES_PASSWORD=eduself_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis 7.2 Configuration (Cache, Channels, Celery)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Authentication (Social & Telegram) - Phase 01+
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Google Sheets API - Phase 09
GOOGLE_SERVICE_ACCOUNT_JSON=

# AI Provider Gateway Keys - Phase 05
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
