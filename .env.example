# ==============================================================================
# EduSelf Teacher — Environment Configuration Template (.env.example)
# Copy this file to .env and fill in the values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Django Core Configuration
# ------------------------------------------------------------------------------
SECRET_KEY=django-insecure-eduself-teacher-core-dev-key-change-in-production-!@#$
DJANGO_SETTINGS_MODULE=core.settings.local
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,api.eduself.uz,teacher.eduself.uz

# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL 16 / SQLite for local tests)
# ------------------------------------------------------------------------------
USE_SQLITE=False
DB_ENGINE=django.db.backends.postgresql
DB_NAME=eduself_db
DB_USER=eduself_user
DB_PASSWORD=eduself_secret_password
DB_HOST=localhost
DB_PORT=5432

# ------------------------------------------------------------------------------
# 3. Redis Cache & Celery Queues (Redis 7.2)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CHANNEL_REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ------------------------------------------------------------------------------
# 4. Authentication (Telegram & Google OAuth2)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=mock_telegram_bot_token
TELEGRAM_BOT_USERNAME=eduself_teacher_bot
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback/

# ------------------------------------------------------------------------------
# 5. Multi-Provider AI Gateway & BYOK Encryption
# ------------------------------------------------------------------------------
MASTER_ENCRYPTION_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 6. Google Sheets Synchronization
# ------------------------------------------------------------------------------
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEETS_SERVICE_ACCOUNT_FILE=

# ------------------------------------------------------------------------------
# 7. Localization & System
# ------------------------------------------------------------------------------
TIME_ZONE=Asia/Tashkent
LANGUAGE_CODE=uz-Latn

# ------------------------------------------------------------------------------
# 8. Production Security (AWS EC2 / HTTPS)
# ------------------------------------------------------------------------------
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000
