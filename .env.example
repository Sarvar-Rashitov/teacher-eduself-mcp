# ==============================================================================
# EduSelf Teacher — Environment Variables Configuration
# ==============================================================================

# Django Core Settings
DJANGO_SECRET_KEY=change-this-insecure-key-in-production
DJANGO_SETTINGS_MODULE=core.settings.local
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# PostgreSQL Database Configuration
POSTGRES_DB=eduself_db
POSTGRES_USER=eduself_user
POSTGRES_PASSWORD=eduself_secret_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
USE_SQLITE=False
USE_IN_MEMORY_CHANNELS=False

# Redis & Channels Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_CHANNEL_URL=redis://localhost:6379/1

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Social Authentication
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Application Metadata
SITE_NAME="EduSelf Teacher"
DEFAULT_LOCALE=uz-Latn
TIME_ZONE=Asia/Tashkent
