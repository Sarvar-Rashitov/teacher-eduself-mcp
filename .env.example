# ============================================================
# EduSelf Teacher — .env.example
# Bu faylni nusxalab .env nomini bering va qiymatlarni kiriting
# cp .env.example .env
# ============================================================

# --- Django asosiy sozlamalari ---
DJANGO_SECRET_KEY=replace_me_with_a_strong_50_character_secret_key
DJANGO_ENV=local
# local muhitda DEBUG=True bo'ladi, production da False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL 16 ---
POSTGRES_DB=eduself
POSTGRES_USER=eduself
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis 7.2 ---
# Kanal qatlami (Django Channels) uchun
REDIS_URL=redis://redis:6379/0
# Celery broker uchun
CELERY_BROKER_URL=redis://redis:6379/1
# Celery natijalar ombori uchun
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Ishlab chiqish qulayligi ---
# Docker ishlatmasdan tezkor local dev uchun SQLite (1=ishlatish, 0=PostgreSQL)
USE_SQLITE=0

# --- Phase 01: Autentifikatsiya (keyinchalik to'ldiriladi) ---
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# GOOGLE_CLIENT_ID=your_google_oauth_client_id
# GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# --- Phase 05: AI Gateway (keyinchalik to'ldiriladi) ---
# MASTER_ENCRYPTION_KEY=base64_encoded_32_byte_key_for_aes256gcm

# --- Phase 09: Google Sheets (keyinchalik to'ldiriladi) ---
# GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
