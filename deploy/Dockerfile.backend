# ==============================================================================
# Multi-Stage Production Dockerfile for EduSelf Teacher Backend
# Complies with DOC-SEC-01 (SECURITY.md) and DEPLOYMENT_ARCHITECTURE.md
# Non-root user: appuser (UID: 10001, GID: 10001)
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Builder
# ------------------------------------------------------------------------------
FROM python:3.12-slim-bookworm AS builder

WORKDIR /build

# Tizim paketlari va kompilyatsiya asboblari
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    gcc \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Virtual muhit yaratish
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY requirements.txt .
RUN pip install --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r requirements.txt

# ------------------------------------------------------------------------------
# Stage 2: Production Runner
# ------------------------------------------------------------------------------
FROM python:3.12-slim-bookworm AS runner

# Muhit o'zgaruvchilari
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH" \
    DJANGO_SETTINGS_MODULE=core.settings.production \
    PORT=8000

WORKDIR /app

# Minimal runtime kutubxonalar va postgresql-client (pg_isready, backup uchun)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    postgresql-client \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Builder'dan virtual muhitni ko'chirish
COPY --from=builder /opt/venv /opt/venv

# Xavfsizlik: Non-root foydalanuvchi yaratish (UID: 10001)
RUN groupadd -g 10001 appgroup && \
    useradd -u 10001 -g appgroup -s /bin/bash -m appuser

# Doimiy kataloglarni yaratish va egalik huquqini berish
RUN mkdir -p /app/staticfiles /app/media /data/logs && \
    chown -R appuser:appgroup /app /data/logs

# Loyiha kodini yuklash
COPY --chown=appuser:appgroup . /app

# Skriptlarga bajarilish huquqini berish
RUN chmod +x /app/deploy/scripts/*.sh

# Xavfsiz foydalanuvchiga o'tish
USER appuser

# Sog'lomlik tekshiruvi (Healthcheck)
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -f http://localhost:8000/health/live/ || exit 1

EXPOSE 8000

ENTRYPOINT ["/app/deploy/scripts/entrypoint.sh"]
CMD ["daphne", "-b", "0.0.0.0", "-p", "8000", "core.asgi:application"]
